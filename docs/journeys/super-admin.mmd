---
title: HR Portal Pro · Super Admin journey
---
flowchart TD
  A(["Super Admin signs in<br/>bootstrap login from Secrets Manager"]):::start --> P{"Password correct?"}:::decide
  P -- "wrong 5 times" --> LK["Account locked"]:::bad
  P -- "yes" --> D["Dashboard<br/>company counts, HR approvals waiting"]:::step
  D --> PW["Change own password<br/>8+ chars, letters and numbers"]:::step
  D --> SET["Company setup"]:::area
  D --> ON["Onboard leaders"]:::area
  D --> USR["Users page"]:::area
  D --> HR["Everything HR Admin can do<br/>see the HR Admin flow"]:::area
  D --> AUD["Audit log<br/>filter by record type, search"]:::step
  D --> API["REST API<br/>Swagger UI, HTTP Basic"]:::step

  SET --> DEP["Departments<br/>add, rename"]:::step
  DEP --> DD{"Delete: has or had employees?"}:::decide
  DD -- "yes" --> DDN["Refused"]:::bad
  DD -- "no" --> DDY["Deleted"]:::good
  SET --> HOL["Holidays<br/>add, delete"]:::step
  HOL --> HD{"Date already a holiday?"}:::decide
  HD -- "yes" --> HDN["Refused"]:::bad
  HD -- "no" --> HDY["Shown on leave forms and calendars"]:::good

  ON --> NEW["New employee form<br/>department, manager, salary, joining date"]:::step
  NEW --> R{"Role chosen"}:::decide
  R -- "HR Admin or Super Admin<br/>only a Super Admin may grant" --> T
  R -- "Manager or Employee" --> T["Login created<br/>temporary password shown once"]:::good
  T --> M1["Welcome email to the new hire<br/>joining email to their manager"]:::mail

  USR --> ROLE{"Change role: own account?"}:::decide
  ROLE -- "yes" --> RN["Refused"]:::bad
  ROLE -- "no" --> RY["Role changed<br/>audit: old → new"]:::good
  USR --> UL["Unlock a locked account<br/>failed attempts reset"]:::good
  USR --> RS["Reset password<br/>temporary password, must change at next sign-in"]:::good
  USR --> EN{"Disable or enable"}:::decide
  EN -- "own account, or re-enable someone who left" --> EN1["Refused"]:::bad
  EN -- "otherwise" --> EN2["Login disabled or enabled"]:::good

  RY & UL & RS & EN2 & DDY & T --> AUD
  classDef start fill:#1f4e79,stroke:#1f4e79,color:#ffffff,font-weight:bold
  classDef step fill:#ffffff,stroke:#9aa7b4,color:#18222c
  classDef area fill:#e5eef6,stroke:#1f4e79,color:#12324f,font-weight:bold
  classDef decide fill:#fff6e6,stroke:#c98a1b,color:#5a3a00
  classDef good fill:#e6f4ea,stroke:#2b8a3e,color:#14532d
  classDef bad fill:#fdecec,stroke:#c92a2a,color:#7f1d1d
  classDef mail fill:#fde8f3,stroke:#c2255c,color:#7a1340
