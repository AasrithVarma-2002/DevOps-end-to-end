#!/bin/bash
# First-boot setup for the bastion (Amazon Linux 2023): MySQL client + kubectl.
set -euxo pipefail
exec > >(tee -a /var/log/hr-portal-setup.log) 2>&1

# The instance can boot before it has internet access (the Elastic IP / NAT route is attached
# a moment later by Terraform), so wait for it instead of failing the install.
for i in $(seq 1 60); do
  curl -fsS --max-time 5 -o /dev/null https://aws.amazon.com && break
  echo "Waiting for internet access ($i/60)..."
  sleep 10
done


dnf -y install mariadb105 jq

KUBECTL_VERSION=$(curl -fsSL "https://dl.k8s.io/release/stable-${kubernetes_version}.txt")
curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl"
chmod +x /usr/local/bin/kubectl

# Every session (including ssm-user) gets the region and cluster name
cat > /etc/profile.d/hr-portal.sh <<ENV
export AWS_DEFAULT_REGION=${region}
export EKS_CLUSTER_NAME=${cluster_name}
ENV

touch /var/lib/hr-portal-setup.done
